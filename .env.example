PORT=8080
MOBILE_DIR=../mobile
UPLOAD_DIR=../data/uploads
DATABASE_URL=postgres://yingbai:yingbai_dev_password@localhost:5432/yingbai?sslmode=disable
SQLITE_DATABASE_PATH=../data/runtime/conversations.db

POSTGRES_DB=yingbai
POSTGRES_USER=yingbai
POSTGRES_PASSWORD=yingbai_dev_password
POSTGRES_PORT=5432

# Qwen embedding through an OpenAI Compatible endpoint
LLM_API_KEY=replace_with_your_dashscope_api_key
LLM_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_MODEL=qwen3.7-text-embedding

# Knowledge retrieval: integer from 1 to 20 (default: 5)
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55

# OpenAI-compatible chat LLM (DeepSeek example)
LLM_CHAT_API_KEY=replace_with_your_deepseek_api_key
LLM_CHAT_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-flash
